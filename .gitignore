venv/
*.code-workspace
__pycache__/

# NOTE: do not gitignore index-kids.html, archive.html, old_issues/, or
# puzzles/ here. peaceiris/actions-gh-pages copies this .gitignore into the
# gh-pages worktree and runs `git add -A` there — any path listed here that
# isn't already tracked on gh-pages (e.g. a new date-stamped puzzle image or
# archive file) silently fails to deploy. These are local-only/untracked on
# main by convention (never `git add -A`'d), not by gitignore.

# kobo-loader annotation files — regenerated each run, gitignored per CLAUDE.md
KOBO.md
.kobo_resolved.json
